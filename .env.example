# Example environment variables
# DEBUG is opt-in and defaults to False so production never silently
# falls back into debug mode (which would expose tracebacks/config).
DJANGO_DEBUG=False

# SECRET_KEY MUST be set in production; there is no safe default.
# Use a long random value, e.g.: python -c "import secrets; print(secrets.token_urlsafe(64))"
SECRET_KEY=change-me-to-a-long-random-value

# Dedicated storage credential. Recommended over the SECRET_KEY fallback.
SUPABASE_SERVICE_ROLE_KEY=

DATABASE_URL=sqlite:///db.sqlite3
